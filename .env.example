# Copy to .env and fill in. Never commit .env.
# Optional: without it the worker uses the rule-based planner.
ANTHROPIC_API_KEY=
MEDREEL_ANTHROPIC_MODEL=claude-opus-5-5
MEDREEL_DATA_DIR=/data
MEDREEL_MAX_UPLOAD_MB=500
MEDREEL_WHISPER_MODEL=base
MEDREEL_WHISPER_COMPUTE_TYPE=int8
MEDREEL_WORKER_POLL_SECONDS=1.0
MEDREEL_LOG_LEVEL=INFO
